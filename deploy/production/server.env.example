# Copy to /etc/mafia/server.env on the server (owner root, group mafia, mode 640).
HOST=127.0.0.1
PORT=8080
# Own role and database on the existing PostgreSQL 16 (see postgres.sql).
DATABASE_URL=postgres://mafia:CHANGE_ME@127.0.0.1:5432/mafia
JWT_SECRET=CHANGE_ME_LONG_RANDOM
LIVEKIT_URL=wss://video.CHANGE_ME_DOMAIN
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_LONG_RANDOM
LAUNCH_COUNTRIES=UZ
STAKE_COUNTRIES=UZ
HOUSE_CUT_PERCENT=10
