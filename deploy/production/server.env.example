# Copy to /etc/mafia/server.env on the server (owner root, group mafia, mode 640).
HOST=127.0.0.1
PORT=8080
# Own role and database on the existing PostgreSQL 16 (see postgres.sql).
DATABASE_URL=postgres://mafia:CHANGE_ME@127.0.0.1:5432/mafia
JWT_SECRET=CHANGE_ME_LONG_RANDOM
LIVEKIT_URL=wss://video.CHANGE_ME_DOMAIN
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_LONG_RANDOM
# The server talks to LiveKit on the same machine, not through nginx.
LIVEKIT_API_URL=http://127.0.0.1:7880
LAUNCH_COUNTRIES=UZ
STAKE_COUNTRIES=UZ
HOUSE_CUT_PERCENT=10
QUICK_MATCH_STAKE=100
# Sign-in codes by SMS through Eskiz (server/lib/auth/README.md).
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=CHANGE_ME
ESKIZ_PASSWORD=CHANGE_ME
ESKIZ_FROM=4546
# Never true in production: it accepts unsigned test tokens.
DEV_AUTH=false
