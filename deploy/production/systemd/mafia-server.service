# The Mafia game server as a plain systemd service. No Docker.
# Install: /etc/systemd/system/mafia-server.service
[Unit]
Description=Mafia game server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=mafia
Group=mafia
EnvironmentFile=/etc/mafia/server.env
ExecStart=/opt/mafia/server/server
WorkingDirectory=/opt/mafia/server
Restart=on-failure
RestartSec=3

# Keep it from crowding out the store app on the same machine.
MemoryHigh=384M
MemoryMax=512M
CPUWeight=50
TasksMax=256

# Hardening: the service can only write where it must.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
